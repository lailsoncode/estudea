# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_MCP_PUBLIC_URL=https://mcp.estudea.example/mcp

# Supabase Edge Functions secret/local env. Do not prefix with VITE_.
GEMINI_API_KEY=your-gemini-key-here

# Estudea MCP server. Prefer a dedicated .env.mcp file locally.
# development uses a secret URL plus one short-lived teacher session token.
MCP_AUTH_MODE=development
MCP_HOST=127.0.0.1
MCP_PORT=3001
MCP_CONNECTION_SECRET=generate-a-long-random-secret
MCP_SUPABASE_ACCESS_TOKEN=short-lived-teacher-access-token
ESTUDEA_APP_URL=http://localhost:5173

# Production OAuth mode with Supabase OAuth Server.
# MCP_AUTH_MODE=oauth
# MCP_PUBLIC_BASE_URL=https://mcp.estudea.example
# MCP_AUTHORIZATION_SERVER_URL=https://your-project-id.supabase.co/auth/v1
# MCP_ALLOWED_HOSTS=mcp.estudea.example
