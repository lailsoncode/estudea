# Frontend Estudea (.env ou variáveis do serviço web no EasyPanel)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_MCP_PUBLIC_URL=https://mcp.estudea.example/mcp

# Supabase Edge Functions secret/local env. Nunca use prefixo VITE_ nesta chave.
GEMINI_API_KEY=your-gemini-key-here

# MCP local (.env.mcp). Somente desenvolvimento e diagnóstico.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
MCP_AUTH_MODE=development
MCP_HOST=127.0.0.1
MCP_PORT=3001
MCP_CONNECTION_SECRET=generate-a-long-random-secret
MCP_SUPABASE_ACCESS_TOKEN=short-lived-teacher-access-token
ESTUDEA_APP_URL=http://localhost:5173

# MCP em produção no EasyPanel. Use no lugar das variáveis de desenvolvimento.
# NODE_ENV=production
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=your-anon-key-here
# MCP_AUTH_MODE=oauth
# MCP_HOST=0.0.0.0
# PORT=3001
# MCP_PUBLIC_BASE_URL=https://mcp.estudea.example
# MCP_AUTHORIZATION_SERVER_URL=https://your-project-id.supabase.co/auth/v1
# MCP_ALLOWED_HOSTS=mcp.estudea.example
# ESTUDEA_APP_URL=https://app.estudea.example
