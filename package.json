  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.worker.config.ts",
    "build:all": "npm run build && npm run mcp:build",
    "mcp:dev": "tsx watch mcp/server.ts",
    "mcp:build": "tsc -p tsconfig.mcp.json",
    "mcp:start": "node dist-mcp/server.js",
    "mcp:test": "tsx --test mcp/**/*.test.ts",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.2.0",
